#!/bin/sh
# mwan6-npt - NPTv6 rule generator for Multi-WAN
# Manages prefix translation rules for active IPv6 WAN interfaces

. /lib/functions.sh
. /usr/share/mwan6-npt/functions.sh

CONFIG="mwan6-npt"
CHAIN_POST_DIR="/usr/share/nftables.d/chain-post"
SRCNAT_FILE="${CHAIN_POST_DIR}/srcnat/99-mwan6-npt.nft"
DSTNAT_FILE="${CHAIN_POST_DIR}/dstnat/99-mwan6-npt.nft"

log() {
    logger -t mwan6-npt "$1"
    echo "$1" >&2
}

find_lan_prefix() {
    local cfg="$1"
    local enabled=""
    local wan_prefix=""
    local is_default=""

    config_get enabled "$cfg" enabled 0
    config_get wan_prefix "$cfg" wan_prefix ""
    config_get is_default "$cfg" default 0

    mwan6_npt_is_true "$enabled" || return 0
    mwan6_npt_is_true "$is_default" || return 0
    [ -n "$wan_prefix" ] || return 0

    LAN_PREFIX="$wan_prefix"
    LAN_IFACE="$cfg"
}

load_config() {
    config_load "$CONFIG"
    LAN_PREFIX=""
    LAN_IFACE=""
    config_foreach find_lan_prefix interface
}

generate_rules() {
    local enabled="0"
    local wan_prefix=""
    local active_count=0
    local validation_failed=0
    local srcnat_tmp="${SRCNAT_FILE}.tmp"
    local dstnat_tmp="${DSTNAT_FILE}.tmp"

    load_config

    [ -n "$LAN_PREFIX" ] || {
        log "Error: No default interface configured"
        return 1
    }

    if ! mwan6_npt_validate_prefix "$LAN_PREFIX"; then
        log "Error: Invalid LAN prefix: $LAN_PREFIX (expected format like 2001:db8::/56)"
        return 1
    fi

    mkdir -p "${CHAIN_POST_DIR}/srcnat"
    mkdir -p "${CHAIN_POST_DIR}/dstnat"

    : >"$srcnat_tmp"
    : >"$dstnat_tmp"

    log "Generating NPTv6 rules for LAN prefix $LAN_PREFIX (interface: $LAN_IFACE)"

    process_interface() {
        local cfg="$1"
        local is_default=""
        local dev=""
        local logical="$cfg"
        local router_addr=""

        config_get enabled "$cfg" enabled 0
        config_get wan_prefix "$cfg" wan_prefix ""
        config_get is_default "$cfg" default 0

        mwan6_npt_is_true "$enabled" || return 0
        [ -n "$wan_prefix" ] || return 0

        if ! mwan6_npt_validate_prefix "$wan_prefix"; then
            log "Error: Invalid wan_prefix on $cfg: $wan_prefix (expected format like 2001:db8::/56)"
            validation_failed=1
            return 0
        fi

        mwan6_npt_is_true "$is_default" && return 0

        if [ "$wan_prefix" = "$LAN_PREFIX" ]; then
            log "Skip $cfg: wan_prefix equals LAN prefix (no NPT needed)"
            return 0
        fi

        dev="$(mwan6_npt_iface_device "$logical")"
        if mwan6_npt_iface_up "$dev"; then
            router_addr="$(mwan6_npt_iface_router_addr "$dev")"
            log "Active interface: $logical ($dev) -> $wan_prefix"

            echo "oifname \"$dev\" ip6 saddr $LAN_PREFIX snat prefix to $wan_prefix;" >>"$srcnat_tmp"
            echo "iifname \"$dev\" ip6 daddr $wan_prefix dnat prefix to $LAN_PREFIX;" >>"$dstnat_tmp"

            # Router-originated traffic: mwan3 fwmark may egress via this oif while
            # busybox ping6 still binds another tunnel's WG source address.
            if [ -n "$router_addr" ]; then
                echo "oifname \"$dev\" ip6 saddr != $wan_prefix snat ip6 to $router_addr;" >>"$srcnat_tmp"
            fi

            active_count=$((active_count + 1))
        else
            log "Interface $logical is down or not found${dev:+ (device: $dev)}"
        fi
    }

    config_foreach process_interface interface

    [ "$validation_failed" -eq 1 ] && {
        log "Error: Fix invalid prefix(es) in /etc/config/mwan6-npt"
        rm -f "$srcnat_tmp" "$dstnat_tmp"
        return 1
    }

    log "Generated rules for $active_count active interfaces"

    if [ "$active_count" -eq 0 ]; then
        log "Warning: No active interfaces found — keeping previous hook files"
        rm -f "$srcnat_tmp" "$dstnat_tmp"
        return 1
    fi

    mv -f "$srcnat_tmp" "$SRCNAT_FILE"
    mv -f "$dstnat_tmp" "$DSTNAT_FILE"
    return 0
}

flush_rules() {
    log "Flushing mwan6-npt rules"
    >"$SRCNAT_FILE" 2>/dev/null
    >"$DSTNAT_FILE" 2>/dev/null
    fw4 reload >/dev/null 2>&1
}

reload_firewall() {
    local output

    log "Reloading firewall"
    output=$(fw4 reload 2>&1) || {
        log "Error: fw4 reload failed: $output"
        return 1
    }
    [ -n "$output" ] && echo "$output" | logger -t mwan6-npt
}

show_status() {
    load_config

    echo "=== mwan6-npt Status ==="
    echo "LAN prefix (default): $LAN_PREFIX"
    echo "LAN interface: ${LAN_IFACE:-(not set)}"
    echo ""
    echo "Active SNAT rules (srcnat):"
    nft list chain inet fw4 srcnat 2>/dev/null | grep -E "snat .*prefix|snat ip6 to" || echo "  (none)"
    echo ""
    echo "Active DNAT rules (dstnat):"
    nft list chain inet fw4 dstnat 2>/dev/null | grep -E "dnat .*prefix" || echo "  (none)"
    echo ""
    echo "Generated rule files:"
    [ -f "$SRCNAT_FILE" ] && echo "  $SRCNAT_FILE:" && cat "$SRCNAT_FILE"
    [ -f "$DSTNAT_FILE" ] && echo "  $DSTNAT_FILE:" && cat "$DSTNAT_FILE"
}

case "$1" in
    update)
        generate_rules && reload_firewall
        ;;
    flush)
        flush_rules
        ;;
    status)
        show_status
        ;;
    *)
        echo "Usage: $0 {update|flush|status}"
        exit 1
        ;;
esac
